{
  "schemaVersion": 1,
  "id": "lsdc",
  "version": "${version}",
  "name": "Sodium Device Check",
  "description": "钠-设备检查",
  "authors": [
    {
      "name": "LoongLy",
      "contact": {
        "homepage": "https://github.com/Long-Zixuan"
      }
    }
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/mc1.16.5-sodium-chinese-localization-pack",
    "issues": "https://github.com/Long-Zixuan/Sodium_Chinese_Localization_Package//issues",
    "sources": "https://github.com/Long-Zixuan/Sodium_Chinese_Localization_Package/"
  },
  "icon": "icon.png",
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "me.loongly.mods.lsdc.fabric.client.LSDCFabricClientMod"
